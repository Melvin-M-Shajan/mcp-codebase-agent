# Groq (LLM: openai/gpt-oss-120b) -- see README "Deviations from PRD" for why Groq
# replaces the PRD's OpenAI/Anthropic default. Embeddings run locally (no key needed).
GROQ_API_KEY=
# Optional: more Groq keys (from separate accounts). gpt-oss-120b's free tier caps out
# at 200k tokens/day, which a full eval run can exceed; each extra key adds another
# key's worth of daily budget (the agent falls through to the next one automatically --
# see README "Deviations from PRD"). GROQ_API_KEY_BACKUP, then GROQ_API_KEY_BACKUP_2,
# GROQ_API_KEY_BACKUP_3, ... as many as you have.
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_BACKUP_2=

# Pinecone (vector store, §8.3)
PINECONE_API_KEY=
# Namespace within the shared index -- PRD §8.3 says "use the repo name as the
# namespace"; not in the PRD's §12 env list but needed so search_code and ingest.py
# agree on where to read/write (documented as a minor addition in README).
PINECONE_NAMESPACE=httpx

# Langfuse (tracing, §9.3)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local path to the cloned target repo (§5, §12) -- pinned to the commit in README.md
REPO_ROOT=./target-repo
